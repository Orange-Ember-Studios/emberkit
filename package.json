{
  "name": "emberkit",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight TypeScript-first JSX framework",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev"
  },
  "devDependencies": {
    "eslint": "^10.0.0",
    "typescript-eslint": "^8.0.0",
    "@eslint/js": "^10.0.0",
    "eslint-plugin-perfectionist": "^4.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  }
}