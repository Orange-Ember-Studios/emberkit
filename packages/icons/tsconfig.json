{
  "extends": "@emberkit/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false,
    "jsx": "react-jsx",
    "jsxImportSource": "@emberkit/core"
  },
  "include": ["src/**/*"]
}