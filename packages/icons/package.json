{
  "name": "@emberkit/icons",
  "version": "0.1.0",
  "type": "module",
  "description": "SVG icon library for EmberKit",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {},
  "peerDependencies": {
    "@emberkit/core": "workspace:*"
  },
  "devDependencies": {
    "@emberkit/core": "workspace:*",
    "@emberkit/tsconfig": "workspace:*"
  }
}