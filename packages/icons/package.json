{
  "name": "@emberkit/icons",
  "version": "1.0.0",
  "type": "module",
  "private": false,
  "description": "SVG icon library for EmberKit",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/orange-ember-studios/emberkit.git",
    "directory": "packages/icons"
  },
  "homepage": "https://emberkit.dev",
  "keywords": [
    "emberkit",
    "icons",
    "svg",
    "components"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "peerDependencies": {
    "@emberkit/core": "workspace:*"
  },
  "devDependencies": {
    "@emberkit/core": "workspace:*",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "typescript-eslint": "^8.59.3"
  }
}
