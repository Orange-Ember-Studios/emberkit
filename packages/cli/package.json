{
  "name": "@emberkit/cli",
  "version": "0.1.2-alpha.0",
  "type": "module",
  "description": "CLI tool for EmberKit projects",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/orange-ember-studios/emberkit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://emberkit.dev",
  "keywords": [
    "emberkit",
