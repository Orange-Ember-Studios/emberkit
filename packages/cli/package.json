{
  "name": "@emberkit/cli",
  "version": "0.6.6",
  "type": "module",
  "private": false,
  "description": "CLI tool for EmberKit projects",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/orange-ember-studios/emberkit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://emberkit.dev",
  "keywords": [
    "emberkit",
    "cli",
    "devtools",
    "vite",
    "framework"
  ],
  "bin": {
    "emberkit": "./bin/emberkit.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "bin"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "inquirer": "^9.2.0",
    "vite": "^6.0.0"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": false
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/inquirer": "^9.0.3",
    "eslint": "^10.0.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "typescript-eslint": "^8.59.3"
  }
}
