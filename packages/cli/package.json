{
  "name": "@emberkit/cli",
  "version": "0.6.1-alpha.11",
  "type": "module",
  "private": false,
  "description": "CLI tool for EmberKit projects",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/orange-ember-studios/emberkit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://emberkit.dev",
  "keywords": [
    "emberkit",
    "cli",
    "devtools",
    "vite",
    "framework"
  ],
  "bin": {
    "emberkit": "./bin/emberkit.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "bin"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "inquirer": "^9.2.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.3"
  }
}