{
  "name": "@emberkit/edge",
  "version": "0.2.0",
  "type": "module",
  "description": "Edge runtime adapter for EmberKit",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/orange-ember-studios/emberkit.git",
    "directory": "packages/edge"
  },
  "homepage": "https://emberkit.dev",
  "keywords": [
    "emberkit",
    "edge",
    "cloudflare",
    "deno",
    "serverless"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "vitest"
  },
  "dependencies": {},
  "devDependencies": {}
}
