{
  "name": "@emberkit/edge",
  "version": "0.2.3",
  "type": "module",
  "private": false,
  "description": "Edge runtime adapter for EmberKit",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/orange-ember-studios/emberkit.git",
    "directory": "packages/edge"
  },
  "homepage": "https://emberkit.dev",
  "keywords": [
    "emberkit",
    "edge",
    "cloudflare",
    "deno",
    "serverless"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "typescript-eslint": "^8.59.3"
  }
}
