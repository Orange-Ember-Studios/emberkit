{
  "name": "@emberkit/core",
  "version": "0.8.0",
  "type": "module",
  "private": false,
  "description": "Lightweight TypeScript-first JSX framework core",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/orange-ember-studios/emberkit.git",
    "directory": "packages/emberkit"
  },
  "homepage": "https://emberkit.dev",
  "keywords": [
    "emberkit",
    "framework",
    "jsx",
    "typescript",
    "ssr",
    "signals"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vite-plugin": {
      "import": "./dist/vite-plugin/index.js",
      "types": "./dist/vite-plugin/index.d.ts"
    },
    "./jsx-runtime": {
      "import": "./dist/jsx-runtime.js",
      "types": "./dist/jsx-runtime.d.ts"
    },
    "./jsx-dev-runtime": {
      "import": "./dist/jsx-dev-runtime.js",
      "types": "./dist/jsx-dev-runtime.d.ts"
    },
    "./logger": {
      "browser": {
        "types": "./dist/logger/browser.d.ts",
        "import": "./dist/logger/browser.js"
      },
      "types": "./dist/logger/node.d.ts",
      "import": "./dist/logger/node.js"
    },
    "./logger/node": {
      "types": "./dist/logger/node.d.ts",
      "import": "./dist/logger/node.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "remark-gfm": "^4.0.0",
    "vite": "^6.0.0",
    "vite-plugin-compression2": "^2.5.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "eslint": "^10.0.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "jsdom": "^29.1.1",
    "typescript-eslint": "^8.59.3",
    "vitest": "^3.0.0"
  }
}